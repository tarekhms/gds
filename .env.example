PORT=3000

# Brevo SMTP (use the SMTP login and SMTP key from Brevo)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=2525
BREVO_SMTP_USER=YOUR_BREVO_SMTP_LOGIN
BREVO_SMTP_KEY=YOUR_BREVO_SMTP_KEY

# Use the sender address verified in Brevo on the authenticated gdswindows.be domain
CONTACT_FROM=info@gdswindows.be
CONTACT_TO=info@gdswindows.be
CONTACT_BCC=tarek.alhomsi@hotmail.com
AUTO_REPLY_ENABLED=1
