PORT=3000

# Brevo SMTP (use the SMTP login and SMTP key from Brevo)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=2525
BREVO_SMTP_USER=YOUR_BREVO_SMTP_LOGIN
BREVO_SMTP_KEY=YOUR_BREVO_SMTP_KEY

# Use a sender address verified in Brevo and on the authenticated gds.be domain
CONTACT_FROM=request@gds.be
CONTACT_TO=request@gds.be
